# Copy to .env.local. Every value is optional: the host comes from the URL the page was
# served from, and the rest fall back to the defaults noted here.

# Dev only. Under `npm run dev` the page is served by your machine while the API and the
# broker live on the Home Assistant host, so this points at that host. A production build
# drops the branch that reads it, so it can never reach the static export.
#
# Pick whichever reaches the host from where you are working:
#   homeassistant.local              on the LAN, no VPN needed
#   homeassistant.tailbedb82.ts.net  anywhere the tailnet reaches, LAN included
#
# Left empty, the host falls back to localhost, which is what turns on the simulation
# branch that fakes the ESP32 instead of talking to it.
NEXT_PUBLIC_DEV_HOST=

# Port the API answers on. Default: 8000
NEXT_PUBLIC_API_PORT=8000

# Broker over WebSocket. Without these, the protocol follows the page (wss when the page is
# https, ws otherwise) and the port follows the protocol (8884 or 1884).
NEXT_PUBLIC_MQTT_PROTOCOL=ws
NEXT_PUBLIC_MQTT_PORT=1884

# Path the broker's WebSocket listener is mounted on. Default: none
NEXT_PUBLIC_MQTT_PATH=

NEXT_PUBLIC_MQTT_USER=
NEXT_PUBLIC_MQTT_PASSWORD=
