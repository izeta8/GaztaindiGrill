# Copy to .env.local for `npm run dev`, or to .env next to compose.yaml on the server.
# Everything here is read by the server at runtime, so changing a value needs a restart,
# never a rebuild. Nothing is NEXT_PUBLIC: the browser gets the broker settings from the page.

# MariaDB the api routes read and write.
DB_HOST=192.168.1.102
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=gaztaindi

# Broker over WebSocket. MQTT_HOST empty means the host the page was served from.
# Set it to localhost to talk to `npm run fake-grill` instead of the ESP32.
MQTT_HOST=192.168.1.102

# Without these, the protocol follows the page (wss when the page is https, ws otherwise)
# and the port follows the protocol (8884 or 1884).
MQTT_PROTOCOL=
MQTT_PORT=

# Path the broker's WebSocket listener is mounted on. Default: none
MQTT_PATH=

MQTT_USER=
MQTT_PASSWORD=
